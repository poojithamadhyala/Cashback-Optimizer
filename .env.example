# Copy to .env.local and fill in. Never commit real secrets.

# --- Database (Section 8: Postgres) -----------------------------------------
# Local Docker example: docker run -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:dev@localhost:5432/loyalty?schema=public"

# --- Auth (Section 4.4) -----------------------------------------------------
# Used to sign session JWTs (jose). Generate: openssl rand -base64 32
AUTH_JWT_SECRET="replace-me-with-a-long-random-secret"
# Session lifetime in seconds (spec: sessions expire). Default 7 days.
AUTH_SESSION_TTL_SECONDS="604800"

# --- OCR provider (Section 4.1 / Section 8) ---------------------------------
# Which OCR implementation to use: "mock" (default, offline-safe, always routes
# to needs_review) or "textract" (AWS Textract AnalyzeExpense).
OCR_PROVIDER="mock"
# Confidence threshold below which a receipt is routed to needs_review (0..1).
OCR_CONFIDENCE_THRESHOLD="0.8"

# --- AWS Textract (only needed when OCR_PROVIDER=textract) -------------------
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Rewards engine defaults ------------------------------------------------
# Cents-per-point used when a points rule omits an explicit pointValueCents.
DEFAULT_POINT_VALUE_CENTS="2"
